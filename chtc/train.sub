# ==============================================================================
# ActionImages-Cogen fusion arm (10-segment canvas) on CHTC GPU Lab.
#
#   ssh tdu35@ap2002.chtc.wisc.edu
#   condor_submit chtc/train.sub                       # F1, the main arm
#   condor_submit chtc/train.sub arm=fusion0-anchor exp=f0ctl   # the F0 control
#
# Override anything:  condor_submit chtc/train.sub steps=20000 exp=myrun
# ==============================================================================

universe          = container
container_image   = docker://DOCKERHUB_USER/aicogen_train:fusion
executable        = chtc/run_train.sh

# --- what to train ---------------------------------------------------------------------------
# fusion0 = the F1 schedule: the MAIN arm. fusion0-anchor = F0, all-anchor, the control that
# isolates what modality dropout itself buys. Both use the same 10-segment template.
arm               = fusion0
steps             = 20000
exp               = $(arm)_$(Cluster)
arguments         = $(arm) $(exp) $(steps)

# --- ONE GPU, chosen by MEMORY not by capability ----------------------------------------------
# At one rank ZeRO-2 has nothing to shard the gradients across, so the peak is ~47-56 GB
# (estimated from a 36.6 GB four-rank measurement; the exact figure depends on whether DeepSpeed
# keeps bf16 or fp32 gradient partitions). That rules OUT L40/L40S at 45 GB and rules IN every
# 80 GB+ card.
#
# Deliberately NOT setting gpus_minimum_capability = 9.0. That would restrict to H100/H200 (24
# cards) and exclude the 8 A100-80GB for no reason: this job needs memory, not SM 9.0 features.
# A100 is ~1.6x slower than H100 here but still far faster than the origin host's RTX 6000 Ada,
# and widening the pool from 24 to 32 matters more than the per-card speed when a single card is
# already hard to get.
request_gpus            = 1
gpus_minimum_memory     = 80000
gpus_minimum_capability = 8.0

request_cpus      = 8
request_memory    = 120GB
# dataset (137 GB, extracted in place and its tarball deleted) + base model 32 GB + warm-start
# ckpt 12 GB + checkpoints. The wrapper prunes all but the newest global_step* before bundling,
# so the steady state is ~12 GB per kept checkpoint plus one ~120 GB resume tip.
request_disk      = 700GB

# --- GPU Lab policy --------------------------------------------------------------------------
+WantGPULab       = true
# "long" = up to 7 days. At an estimated 35-45 s/step on one H100 with accumulation, that is
# roughly 14-17k steps per job; run_train.sh self-resumes from the previous bundle, so reaching
# 20k takes two submissions rather than one heroic job.
+GPUJobLength     = "long"
# TRUE, unlike the openpi template: run_train.sh packages checkpoints on TERM and unpacks a
# previous bundle on start, so this job genuinely survives eviction. Declaring it resumable also
# makes it eligible for backfill capacity on research-group GPUs.
+is_resumable     = true

# --- inputs ----------------------------------------------------------------------------------
# Staged once with chtc/stage_to_chtc.sh, then reused by every submission.
staging           = /staging/tdu35
transfer_input_files = file://$(staging)/rlbench_selfgen_512_aug_wide.tar, file://$(staging)/Wan2.2-TI2V-5B.tar, file://$(staging)/step5000.ckpt

# --- outputs ---------------------------------------------------------------------------------
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_output_files   = checkpoint_bundle.tar
# Keyed on exp, not arm: two runs of the same arm must not overwrite each other, and
# run_train.sh looks for exactly this path to self-resume.
transfer_output_remaps  = "checkpoint_bundle.tar = file://$(staging)/fusion/$(exp).tar"

# --- credentials -----------------------------------------------------------------------------
# getenv passes WANDB_API_KEY from the submit shell. Never write it in this file: submit files are
# plain text and this one is in git.
#   export WANDB_API_KEY=...     (on ap2002, ideally from a chmod-600 file)
getenv            = True
environment       = "HOME=$_CONDOR_SCRATCH_DIR XDG_CACHE_HOME=$_CONDOR_SCRATCH_DIR/.cache HF_HOME=$_CONDOR_SCRATCH_DIR/.cache/hf WANDB_DIR=$_CONDOR_SCRATCH_DIR/.cache/wandb WANDB_PROJECT=actionimages-cogen WANDB_ENTITY=tingtingdu06-uw-madison STAGING_DIR=$(staging)"

log               = logs/fusion_$(Cluster).log
output            = logs/fusion_$(Cluster).out
error             = logs/fusion_$(Cluster).err
stream_output     = True
stream_error      = True

Requirements      = (Target.HasCHTCStaging == true)

queue 1
